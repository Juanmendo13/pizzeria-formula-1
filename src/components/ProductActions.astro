---
interface Props {
  slug: string;
  nombre: string;
  signedIn: boolean;
  isPizza: boolean;
  precios?: { pequeña: number; mediana: number; familiar: number };
  precioNumero?: number;
  imagen?: string;
}

const { slug, nombre, signedIn, isPizza, precios, precioNumero, imagen } = Astro.props;

const sizes = isPizza && precios
  ? [
      { key: 'pequeña', label: 'Pequeña', price: precios.pequeña },
      { key: 'mediana', label: 'Mediana', price: precios.mediana },
      { key: 'familiar', label: 'Familiar', price: precios.familiar },
    ]
  : [];
---

<div
  class="space-y-6"
  data-product-actions
  data-slug={slug}
  data-nombre={nombre}
  data-signed-in={signedIn ? 'true' : 'false'}
  data-is-pizza={isPizza ? 'true' : 'false'}
  data-precio={precioNumero ?? ''}
  data-imagen={imagen ?? ''}
>
  {
    isPizza && sizes.length > 0 && (
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-zinc-500 mb-3">Elige tamaño</p>
        <div class="grid grid-cols-3 gap-3" role="radiogroup" aria-label="Tamaño de pizza">
          {sizes.map((size, index) => (
            <label class="cursor-pointer">
              <input
                type="radio"
                name="pizza-size"
                value={size.key}
                checked={index === 1}
                class="peer sr-only"
                data-size={size.key}
                data-size-label={size.label}
                data-price={String(size.price)}
              />
              <div class="rounded-lg border border-zinc-800 bg-zinc-950 px-3 py-3 text-center transition peer-checked:border-red-600 peer-checked:bg-red-950/30 hover:border-zinc-600">
                <p class="font-mono text-[10px] uppercase tracking-wider text-zinc-500">{size.label}</p>
                <p class="font-mono text-sm font-bold text-red-500">
                  {size.price.toFixed(2).replace('.', ',')}€
                </p>
              </div>
            </label>
          ))}
        </div>
      </div>
    )
  }

  {
    !isPizza && precioNumero !== undefined && (
      <div class="rounded-lg border border-zinc-800 bg-zinc-950 px-4 py-3 inline-block">
        <p class="font-mono text-xs uppercase tracking-wider text-zinc-500">Precio</p>
        <p class="font-mono text-2xl font-bold text-red-500">{precioNumero.toFixed(2).replace('.', ',')}€</p>
      </div>
    )
  }

  <button
    type="button"
    class="w-full sm:w-auto px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-mono font-bold uppercase rounded-lg transition shadow-lg shadow-red-900/30"
    data-add-to-cart
  >
    Añadir al carrito
  </button>

  <p class="text-sm text-zinc-500 font-mono hidden" data-cart-feedback></p>
</div>

<script>
  import { addToCart, cartLineKey } from '../lib/cart.ts';
  import type { PizzaSize } from '../lib/menu.ts';

  function showFeedback(root: HTMLElement, message: string, ok = true) {
    const feedback = root.querySelector('[data-cart-feedback]');
    if (!(feedback instanceof HTMLElement)) return;
    feedback.textContent = message;
    feedback.classList.remove('hidden', 'text-red-400', 'text-green-400');
    feedback.classList.add(ok ? 'text-green-400' : 'text-red-400');
  }

  function selectedSize(root: HTMLElement) {
    const selected = root.querySelector('input[name="pizza-size"]:checked');
    if (!(selected instanceof HTMLInputElement)) return null;
    return {
      size: selected.dataset.size as PizzaSize | undefined,
      sizeLabel: selected.dataset.sizeLabel,
      price: Number(selected.dataset.price),
    };
  }

  function bindActions(root: HTMLElement) {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const addBtn = root.querySelector('[data-add-to-cart]');
    addBtn?.addEventListener('click', () => {
      const signedIn = root.dataset.signedIn === 'true';
      const slug = root.dataset.slug ?? '';
      const nombre = root.dataset.nombre ?? '';
      const isPizza = root.dataset.isPizza === 'true';
      const imagen = root.dataset.imagen || undefined;
      const precioRaw = root.dataset.precio;
      const returnUrl = encodeURIComponent(window.location.pathname);

      if (!signedIn) {
        window.location.href = `/sign-in?redirect_url=${returnUrl}`;
        return;
      }

      if (!slug || !nombre) {
        showFeedback(root, 'No se pudo añadir este producto.', false);
        return;
      }

      if (isPizza) {
        const selected = selectedSize(root);
        if (!selected?.size || Number.isNaN(selected.price)) {
          showFeedback(root, 'Elige un tamaño antes de añadir.', false);
          return;
        }

        addToCart({
          key: cartLineKey(slug, selected.size),
          slug,
          nombre,
          size: selected.size,
          sizeLabel: selected.sizeLabel,
          precio: selected.price,
          imagen,
        });
        showFeedback(root, `Añadida (${selected.sizeLabel}) al carrito.`);
        return;
      }

      const precioNumero = precioRaw === '' ? NaN : Number(precioRaw);
      if (Number.isNaN(precioNumero)) {
        showFeedback(root, 'Este producto no tiene precio.', false);
        return;
      }

      addToCart({
        key: cartLineKey(slug),
        slug,
        nombre,
        precio: precioNumero,
        imagen,
      });
      showFeedback(root, 'Añadido al carrito.');
    });
  }

  document.querySelectorAll('[data-product-actions]').forEach((el) => {
    if (el instanceof HTMLElement) bindActions(el);
  });
</script>
