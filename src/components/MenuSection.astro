---
// src/components/MenuSection.astro
import CategoryCard from './CategoryCard.astro'; // Importamos tu nueva tarjeta

interface Item {
  nombre: string;
  descripcion?: string;
  precio: string;
  nuevo?: boolean;
  slug: string;
}

interface Props {
  categoria: string;
  imagen?: string;
  items: Item[];
  nota?: string;
}

const { categoria, imagen, items, nota } = Astro.props;
---

<details class="group bg-zinc-950 border border-zinc-800 open:border-red-600 rounded-xl overflow-hidden transition-all duration-200">
  <summary class="flex justify-between items-center p-5 cursor-pointer list-none select-none hover:bg-zinc-900/50 transition">
    
    {/* Renderizamos tu nuevo componente pasándole los datos necesarios */}
    <CategoryCard categoria={categoria} imagen={imagen} />
    
    <span class="text-zinc-600 group-open:text-red-500 group-open:rotate-180 transition-transform duration-200 font-mono text-xs">
      ▼
    </span>
  </summary>

  <div class="bg-black border-t border-zinc-900 px-5 pb-5 pt-2">
    {nota && (
      <div class="bg-red-950/20 border-l-2 border-red-600 px-4 py-2 my-3 rounded-r-md text-sm text-zinc-400 font-mono">
        🏎️ {nota}
      </div>
    )}
    
    <ul class="divide-y divide-zinc-900">
      {items.map((item) => (
        <li>
          <a
            href={`/producto/${item.slug}`}
            class="flex justify-between items-start py-4 gap-6 hover:bg-zinc-900/40 -mx-2 px-2 rounded-lg transition group"
          >
            <div class="flex flex-col gap-1 min-w-0">
              <span class="text-zinc-100 font-bold text-base inline-flex items-center gap-2 flex-wrap group-hover:text-white">
                {item.nombre}
                {item.nuevo && (
                  <span class="font-mono text-[10px] uppercase tracking-wider bg-red-600 text-white px-1.5 py-0.5 rounded">New</span>
                )}
              </span>
              {item.descripcion && (
                <p class="text-zinc-500 text-sm leading-relaxed">{item.descripcion}</p>
              )}
            </div>
            <span class="font-mono font-bold text-red-500 bg-red-950/30 border border-red-900/30 px-2.5 py-1 rounded text-sm whitespace-nowrap shrink-0">
              {item.precio}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  summary {
    list-style: none;
  }
</style>