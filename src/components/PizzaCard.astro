---
// src/components/PizzaCard.astro
interface Props {
  pizza: {
    num: string;
    name: string;
    desc: string;
    tag: string;
  };
  imgUrl: string;
}

const { pizza, imgUrl } = Astro.props;
---

<div
  class="group relative overflow-hidden cursor-default transition-all duration-300 bg-[#111] border border-white/10 hover:bg-[#1a0000] hover:border-brand-red"
>
  <div class="relative h-40 overflow-hidden">
    <img
      src={imgUrl}
      alt={pizza.name}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.06]"
    />
    {/* Overlay degradado */}
    <div class="absolute inset-0 bg-gradient-to-t from-[#111] via-transparent to-transparent"></div>
    
    {/* Bandera F1 y Número */}
    <div class="absolute top-0 left-0 flex">
      <div class="checkered-sm w-4 h-7" />
      <span
        class="px-2 py-0.5 text-xs font-bold text-white bg-brand-red font-condensed tracking-widest"
      >
        #{pizza.num}
      </span>
    </div>

    {/* Etiqueta especial (Tag) */}
    {pizza.tag && (
      <span
        class="absolute top-2 right-2 px-2 py-0.5 text-xs font-bold text-black bg-[#F5F5F5] font-condensed"
      >
        {pizza.tag.toUpperCase()}
      </span>
    )}
  </div>

  <div class="p-4">
    <h3
      class="text-lg text-white mb-1 leading-tight font-display tracking-wider"
    >
      {pizza.name.toUpperCase()}
    </h3>
    <p class="text-xs text-white/50 font-body">
      {pizza.desc}
    </p>
  </div>

  {/* Línea roja animada al hacer hover abajo */}
  <div
    class="absolute bottom-0 left-0 h-0.5 w-0 bg-brand-red transition-all duration-300 group-hover:w-full"
  />
</div>