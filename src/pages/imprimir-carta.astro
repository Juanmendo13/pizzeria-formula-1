---
export const prerender = true;

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import '@fontsource/barlow-condensed/latin-700.css';
import menuData from '../data/menu.json';
import '../styles/global.css';

const imagenesPizzas = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/pizzas/*.{jpeg,jpg,png,gif,webp}',
  { eager: true },
);
const imagenesCategorias = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/categorias/*.{jpeg,jpg,png,gif,webp}',
  { eager: true },
);

const pizzasPrimeraPagina = menuData.pizzas.slice(0, 6);
const pizzasSegundaPagina = menuData.pizzas.slice(6);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Carta Pizzería Fórmula 1</title>
    <style>
      .font-racing {
        font-family: 'Barlow Condensed', ui-sans-serif, sans-serif;
        font-style: italic;
      }
      .font-menu {
        font-family: 'Barlow Condensed', ui-sans-serif, sans-serif;
      }

      @page {
        size: A4 landscape;
        margin: 0;
      }

      .pagina-menu {
        page-break-after: always;
        break-after: page;
        width: 297mm;
        height: 210mm;
        max-height: 210mm;
        padding: 1.4rem 2rem 1.2rem;
        box-sizing: border-box;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }

      .grid-pizzas {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-auto-rows: min-content;
        column-gap: 2rem;
        row-gap: 0.3rem;
        flex: 1 1 auto;
        min-height: 0;
        align-content: start;
      }

      .pagina-menu:last-child {
        page-break-after: avoid;
        break-after: auto;
      }

      /* EL TRUCO REACTIVO: Forzamos a que actúe como un bloque elástico inline */
      .bloque-reactivo {
        page-break-inside: avoid;
        break-inside: avoid;
        display: inline-block;
        width: 100%;
      }

      .linea-puntos {
        flex-grow: 1;
        border-bottom: 2px dotted #4b5563;
        margin: 0 8px;
        position: relative;
        top: -6px;
      }

      @media print {
        html,
        body {
          background-color: #09090b !important;
          color: #f4f4f5 !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
        .pagina-menu {
          background-color: #09090b !important;
        }
        h1,
        h2,
        h3,
        span,
        p,
        li {
          color: #ffffff !important;
        }
        .text-red-important {
          color: #dc2626 !important;
        }
        .text-zinc-important {
          color: #d4d4d8 !important;
        }
        .bg-box-important {
          background-color: #111113 !important;
          border-color: #27272a !important;
        }
      }
    </style>
  </head>
  <body class="bg-zinc-950 text-zinc-100 font-menu antialiased">
    
    <!-- BOTÓN DE RETORNO A BOXES (Solo visible en pantalla, oculto en impresión) -->
    <div class="max-w-7xl mx-auto px-6 pt-8 pb-4 print:hidden flex justify-start">
      <a
        href="/"
        class="inline-flex items-center gap-3 px-6 py-4 bg-zinc-900 hover:bg-zinc-800 border-2 border-zinc-800 hover:border-red-600 text-zinc-300 hover:text-white font-racing tracking-wider rounded-xl shadow-lg shadow-black/50 transform hover:-translate-y-0.5 transition duration-200 group text-sm uppercase font-black"
      >
        <span class="text-base transform group-hover:-translate-x-1 transition-transform">
          🏁 &larr;
        </span>
        Volver al Inicio (Boxes)
      </a>
    </div>

    <!-- ================= PÁGINA 1: EL GRAN PREMIO (PIZZAS COHESIVAS) ================= -->
    <div class="pagina-menu">
      <div class="text-center border-b-4 border-red-600 pb-1.5 mb-3">
        <div class="text-red-500 font-racing text-[10px] tracking-widest uppercase mb-0.5">
          Official Track Menu
        </div>
        <h1 class="text-3xl font-black tracking-wider text-white uppercase font-racing italic">
          PIZZERÍA FÓRMULA 1
        </h1>
      </div>

      <div class="text-center mb-3">
        <h2 class="text-xl font-bold font-racing text-red-500 text-red-important uppercase tracking-widest italic inline-block bg-zinc-900 bg-box-important border border-zinc-800 px-6 py-1 rounded-xl">
          🍕 NUESTRAS PIZZAS (GRAN PREMIO) 🍕
        </h2>
        <p class="text-zinc-500 font-mono text-[10px] uppercase tracking-widest mt-1.5">
          Precios: Pequeña / Mediana / Familiar
        </p>
      </div>

      <div class="grid-pizzas px-2">
        {
          pizzasPrimeraPagina.map((pizza) => {
            const pizzaImg = imagenesPizzas[`/src/assets/pizzas/${pizza.imagen}`];
            return (
              <div class="flex items-center gap-3 border-b border-zinc-900 pb-1 min-h-0">
                {pizzaImg && (
                  <div class="w-10 h-10 rounded-lg overflow-hidden border border-red-600/30 flex-shrink-0 bg-zinc-900">
                    <Image
                      src={pizzaImg.default}
                      alt={pizza.nombre}
                      width={40}
                      height={40}
                      densities={[2]}
                      quality={60}
                      loading="eager"
                      decoding="async"
                      class="w-full h-full object-cover"
                    />
                  </div>
                )}
                <div class="flex-grow min-w-0">
                  <div class="flex justify-between items-end w-full">
                    <h3 class="text-lg font-bold text-white uppercase tracking-wide truncate">
                      <span class="text-red-500 text-red-important font-mono mr-1">
                        {pizza.id}.
                      </span>{" "}
                      {pizza.nombre}
                    </h3>
                    <div class="linea-puntos" />
                    <span class="text-red-500 text-red-important font-mono font-bold text-xs whitespace-nowrap">
                      {pizza.precios.pequeña.toFixed(2).replace('.', ',')} / {pizza.precios.mediana.toFixed(2).replace('.', ',')} / {pizza.precios.familiar.toFixed(2).replace('.', ',')}€
                    </span>
                  </div>
                  <p class="text-zinc-400 text-zinc-important text-xs italic font-sans leading-tight pr-2 truncate">
                    {pizza.ingredientes}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- ================= PÁGINA 2: PIZZAS 06–10 (TEXANA INCLUIDA) ================= -->
    <div class="pagina-menu">
      <div class="text-center border-b-4 border-red-600 pb-1.5 mb-3">
        <div class="text-red-500 font-racing text-[10px] tracking-widest uppercase mb-0.5">
          Official Track Menu
        </div>
        <h1 class="text-2xl font-black tracking-wider text-white uppercase font-racing italic">
          PIZZAS (CONTINUACIÓN)
        </h1>
      </div>

      <div class="grid-pizzas px-2 mt-4">
        {
          pizzasSegundaPagina.map((pizza) => {
            const pizzaImg = imagenesPizzas[`/src/assets/pizzas/${pizza.imagen}`];
            return (
              <div class="flex items-center gap-3 border-b border-zinc-900 pb-1 min-h-0">
                {pizzaImg && (
                  <div class="w-10 h-10 rounded-lg overflow-hidden border border-red-600/30 flex-shrink-0 bg-zinc-900">
                    <Image
                      src={pizzaImg.default}
                      alt={pizza.nombre}
                      width={40}
                      height={40}
                      densities={[2]}
                      quality={60}
                      loading="eager"
                      decoding="async"
                      class="w-full h-full object-cover"
                    />
                  </div>
                )}
                <div class="flex-grow min-w-0">
                  <div class="flex justify-between items-end w-full">
                    <h3 class="text-lg font-bold text-white uppercase tracking-wide truncate">
                      <span class="text-red-500 text-red-important font-mono mr-1">
                        {pizza.id}.
                      </span>{" "}
                      {pizza.nombre}
                    </h3>
                    <div class="linea-puntos" />
                    <span class="text-red-500 text-red-important font-mono font-bold text-xs whitespace-nowrap">
                      {pizza.precios.pequeña.toFixed(2).replace('.', ',')} / {pizza.precios.mediana.toFixed(2).replace('.', ',')} / {pizza.precios.familiar.toFixed(2).replace('.', ',')}€
                    </span>
                  </div>
                  <p class="text-zinc-400 text-zinc-important text-xs italic font-sans leading-tight pr-2 truncate">
                    {pizza.ingredientes}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- ================= PÁGINA 3: EN BOXES (COMPLEMENTOS) ================= -->
    <div class="pagina-menu">
      <div class="text-center mb-5 mt-2">
        <h2 class="text-2xl font-bold font-racing text-red-500 text-red-important uppercase tracking-widest italic inline-block bg-zinc-900 bg-box-important border border-zinc-800 px-8 py-1.5 rounded-xl">
          🛠️ EN BOXES: COMPLEMENTOS, BURGERS Y MÁS 🛠️
        </h2>
      </div>

      {
        /* Usamos columns-3 nativo. El navegador apilará las tarjetas rellenando los huecos vacíos verticalmente */
      }
      <div class="columns-3 gap-5 flex-grow overflow-hidden px-2">
        {
          menuData.otrasCategorias.map((cat) => {
            const catImg = imagenesCategorias[`/src/assets/categorias/${cat.imagen}`];
            return (
              <div class="bloque-reactivo mb-4 border border-zinc-800 bg-box-important p-4 rounded-xl bg-zinc-900/40">
                <div class="flex items-center gap-2 border-b-2 border-red-600 pb-2 mb-3">
                  {catImg && (
                    <div class="w-7 h-7 rounded-lg overflow-hidden border border-zinc-700 flex-shrink-0">
                      <Image
                        src={catImg.default}
                        alt={cat.categoria}
                        width={28}
                        height={28}
                        densities={[2]}
                        quality={60}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                      />
                    </div>
                  )}
                  <h3 class="font-racing font-black text-sm text-white uppercase tracking-wider truncate">
                    {cat.categoria}
                  </h3>
                </div>

                <ul class="space-y-2">
                  {cat.items.map((item) => (
                    <li class="flex justify-between items-baseline text-sm border-b border-zinc-900/40 pb-1 last:border-0 last:pb-0">
                      <span class="text-zinc-200 font-medium tracking-wide leading-tight truncate pr-2">
                        {item.nombre}
                      </span>
                      <span class="font-mono font-bold text-red-500 text-red-important whitespace-nowrap text-xs">
                        {item.precio}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })
        }
      </div>
    </div>
  </body>
</html>