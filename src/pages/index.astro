---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Ticker from '../components/Ticker.astro';
import PizzaCard from '../components/PizzaCard.astro';
import MenuSection from '../components/MenuSection.astro';
import Footer from '../components/Footer.astro';
import menu from '../data/menu.json';
---

<Layout title="Pizzería Fórmula 1 | Carta">
  <Navbar />

  <main class="bg-black min-h-screen text-white">
    {/* 1. Sección Principal (Hero) */}
    <section class="relative pt-32 pb-20 px-4 sm:px-6 lg:px-8 text-center max-w-7xl mx-auto">
      <span class="text-red-500 font-mono tracking-widest uppercase text-sm font-bold animate-pulse">
        🏁 Semáforo en Verde 🏁
      </span>
      <h1 class="text-5xl md:text-8xl font-black mt-4 mb-6 font-mono italic tracking-tight uppercase leading-none">
        Pizzería <span class="text-red-600 block sm:inline">Fórmula 1</span>
      </h1>
      <p class="text-zinc-400 max-w-2xl mx-auto text-base md:text-xl leading-relaxed">
        Las pizzas más rápidas y sabrosas de la ciudad. Masa artesanal estirada a mano, ingredientes de primera calidad y un sabor que te llevará directo al podio.
      </p>

      {/* Botones de acción rápida */}
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a 
          href="#carta" 
          class="px-8 py-4 bg-red-600 hover:bg-red-700 text-white font-mono font-bold uppercase rounded-lg transform hover:-translate-y-1 transition duration-300 shadow-lg shadow-red-900/30"
        >
          Ver la Carta 🏎️
        </a>
        <a 
          href="tel:955XXXXXX" 
          class="px-8 py-4 bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 text-white font-mono font-bold uppercase rounded-lg transform hover:-translate-y-1 transition duration-300"
        >
          Llamar Pedido 📞
        </a>
      </div>
    </section>

    {/* 2. Ticker Animado */}
    <div class="border-y border-zinc-800 bg-zinc-950 py-4">
      <Ticker />
    </div>

    {/* 3. Sección: La Escudería (Sobre Nosotros) */}
    <section id="escuderia" class="pt-24 pb-12 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto scroll-mt-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-red-500 font-mono text-xs uppercase tracking-widest font-bold block mb-2">
            🏎️ Desde el Garaje
          </span>
          <h2 class="text-3xl md:text-5xl font-black font-mono italic uppercase mb-6">
            Nuestra Historia
          </h2>
          <div class="space-y-4 text-zinc-400 leading-relaxed text-sm md:text-base">
            <p>
              Fundada por apasionados del motor y de la buena mesa, <strong class="text-white">Pizzería Fórmula 1</strong> nació con un objetivo claro: romper el cronómetro del sabor sin sacrificar la calidad artesanal.
            </p>
            <p>
              Cada mañana encendemos los motores de nuestros hornos para alcanzar la temperatura perfecta de carrera. Estiramos la masa a mano siguiendo técnicas tradicionales y seleccionamos los ingredientes más frescos para que cada porción sea una vuelta rápida perfecta.
            </p>
            <p class="border-l-2 border-red-600 pl-4 italic text-zinc-300 font-mono text-xs md:text-sm">
              "No solo hacemos pizzas rápidas; diseñamos alta ingeniería gastronómica para llevarte directo al podio."
            </p>
          </div>
        </div>
        
        {/* Espacio para imagen del local o equipo */}
        <div class="relative group rounded-2xl overflow-hidden border border-zinc-800 bg-zinc-900/50 p-2">
          <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent z-10"></div>
          <img 
            src="/images/nosotros-boxes.jpg" 
            alt="Nuestros maestros pizzeros en boxes" 
            class="w-full h-80 object-cover rounded-xl grayscale group-hover:grayscale-0 transition duration-500"
          />
          <div class="absolute bottom-6 left-6 z-20 font-mono">
            <p class="text-xs text-red-500 uppercase font-bold">Jefe de Escudería</p>
            <p class="text-lg font-black uppercase text-white">El Equipo de Boxes</p>
          </div>
        </div>
      </div>
    </section>

    {/* 4. La Grid de Pizzas */}
    <section id="carta" class="pt-24 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto scroll-mt-20">
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-red-500/30 bg-red-500/10 text-red-500 font-mono text-xs uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          Box Stop: Elige tu Escudería
        </div>
        <h2 class="text-3xl md:text-5xl font-black font-mono italic uppercase">
          Nuestras Pizzas
        </h2>
        <p class="text-zinc-500 max-w-md mx-auto mt-2 text-sm">
          Pide por número para un servicio a boxes ultra rápido.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {menu.pizzas.map((pizza) => (
          <PizzaCard 
            id={pizza.id}
            nombre={pizza.nombre}
            ingredientes={pizza.ingredientes}
            imagen={pizza.imagen}
          />
        ))}
      </div>
    </section>

    {/* 5. Aviso Técnico de Alérgenos */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <div class="bg-zinc-950/50 border border-zinc-900 rounded-xl p-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-3">
          <span class="text-xl">⚠️</span>
          <div>
            <h4 class="font-mono text-sm font-bold text-white uppercase">Especificaciones de Seguridad (Alérgenos)</h4>
            <p class="text-xs text-zinc-500">Nuestras masas estándar contienen gluten. Disponemos de opciones adaptadas bajo petición previa en boxes.</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-2 text-xs font-mono text-zinc-400 bg-black px-3 py-2 rounded-lg border border-zinc-900">
          <span class="text-red-500 font-bold">[G]</span> Gluten
          <span class="text-red-500 font-bold">[L]</span> Lácteos
          <span class="text-red-500 font-bold">[H]</span> Huevo
          <span class="text-red-500 font-bold">[N]</span> Frutos de cáscara
        </div>
      </div>
    </div>

    {/* 6. Zona de Descarga de PDF */}
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4 pb-20 px-4 print:hidden">
      <a 
        href="/carta-formula1.pdf" 
        download
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-6 py-3 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-red-600 text-zinc-300 hover:text-white font-mono text-sm font-bold uppercase rounded-lg transition duration-300 shadow-md group"
      >
        <span class="transform group-hover:scale-110 transition">📥</span> Descargar Menú PDF
      </a>

      <a 
        href="/imprimir-carta" 
        target="_blank"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-6 py-3 bg-red-600/10 hover:bg-red-600/20 border border-red-500/30 hover:border-red-500 text-red-400 hover:text-red-300 font-mono text-sm font-bold uppercase rounded-lg transition duration-300 shadow-md"
      >
        <span>👀</span> Ver Carta en Pantalla Completa
      </a>
    </div>

    {/* 7. Sección de Complementos */}
    <section id="complementos" class="pb-32 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto scroll-mt-24">
      <div class="text-center mb-12">
        <h3 class="text-2xl md:text-3xl font-black font-mono italic uppercase tracking-tight">
          🏁 Otros Complementos de Boxes
        </h3>
        <p class="text-zinc-500 text-xs font-mono mt-2">Acompaña tu menú principal antes de ver la bandera a cuadros</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
        {menu.otrasCategorias.map((seccion) => (
          <MenuSection 
            categoria={seccion.categoria}
            imagen={seccion.imagen}
            items={seccion.items}
            nota={seccion.nota}
          />
        ))}
      </div>
    </section>
  </main>

  {/* 8. Footer de la Página */}
  <div id="contacto" class="scroll-mt-24">
    <Footer />
  </div>

  {/* 9. Botón Volver Arriba Flotante */}
  <button
    id="btn-back-to-top"
    class="fixed bottom-6 right-6 z-50 p-4 bg-zinc-950 hover:bg-zinc-900 border-2 border-zinc-800 hover:border-red-600 text-red-600 hover:text-white rounded-xl shadow-2xl shadow-black/80 font-mono text-xl font-black uppercase transition-all duration-300 translate-y-20 opacity-0 pointer-events-none print:hidden group"
    aria-label="Volver arriba"
  >
    <span class="inline-block transform group-hover:-translate-y-1 transition-transform">▲</span>
  </button>

  <script>
    const backToTopBtn = document.getElementById('btn-back-to-top');

    window.addEventListener('scroll', () => {
      if (window.scrollY > 400) {
        backToTopBtn?.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        backToTopBtn?.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      } else {
        backToTopBtn?.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
        backToTopBtn?.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }
    });

    backToTopBtn?.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  </script>
</Layout>